# Copy to .env and fill in for your cluster. .env is git-ignored; scripts/slurm/submit.sh reads it.

# --- paths ---
OA_REPO=/path/to/omniarch_pt              # this repository, as seen from the compute nodes
OA_PYTHON=python3                         # interpreter with PyTorch (a venv path works too)
PDEBENCH_ROOT=/path/to/pdebench           # raw PDEBench download (1D/ 2D/ 3D/ folders)
OA_DATA=/path/to/processed/omniarch       # output of scripts/prepare_pdebench.py; node-local disk is fastest
OA_RUNS=/path/to/runs                     # checkpoints and training logs
OA_LOGS=/path/to/slurm-logs               # Slurm stdout/stderr

# --- Slurm ---
SLURM_GPU_PARTITION=gpu
SLURM_CPU_PARTITION=cpu                   # for data preparation
SLURM_NODE=                               # optional: pin training to one node
OA_GPUS=4                                 # GPUs per training job (one node)
OA_CPUS=48
OA_MEM=160G

# --- optional ---
OMNIARCH_FUSED=1                          # fused Triton decoder kernel (CUDA only), ~1.8-2.7x faster training
OMNIARCH_METRICS_LIB=                     # directory of a site metrics.py exposing log(name, value, step, split=...)
